{
  "name": "flowee",
  "version": "0.1.0",
  "private": true,
  "description": "Ticket flow for AI agent teams, with a Telegram envoy for the human in the loop",
  "license": "MIT",
  "author": "Nachtalb <na@nachtalb.io>",
  "repository": "github:Nachtalb/flowee",
  "type": "module",
  "scripts": {
    "test": "bun scripts/bundle.ts && vitest run && bun run test:bun",
    "test:bun": "bun --bun vitest run -c vitest.bun.config.ts",
    "bundle": "bun scripts/bundle.ts",
    "test:client": "python3 client/test_flowee.py",
    "typecheck": "tsc",
    "schema": "bun scripts/schema.ts",
    "dev": "wrangler dev",
    "start": "bun src/runtime/bun/main.ts",
    "compile": "bun scripts/compile.ts",
    "compile:tui": "bun build --compile --minify --sourcemap=none tui/main.ts --outfile dist/flowee-tui",
    "tui": "bun tui/main.ts",
    "validate": "bun scripts/validate.ts",
    "deploy": "bun scripts/deploy.ts",
    "flow": "bun scripts/flow.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261122.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0",
    "xstate": "^5.20.0"
  }
}
