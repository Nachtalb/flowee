      "flow": {
        "preset": "pr-release"
      },
      "features": {
        "pullRequests": {
          "checks": [
            "build"
          ],
          "method": "squash"
        },
        "releases": {
          "testedTag": "tested",
          "checks": [
            "build"
          ]
        },
        "samples": {
          "root": "Samples/"
        },
        "uiReview": {
          "paths": [
            "**/ui/**"
          ],
          "addedLines": [
            "@Composable"
          ],
          "ignore": [
            "formats/**"
          ]
