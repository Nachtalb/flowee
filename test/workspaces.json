    {
      "flowee": 1,
      "id": "viewer",
      "flow": {
        "preset": "pr-release"
      },
      "features": {
        "pullRequests": {
          "checks": [
            "build"
          ],
          "method": "squash"
        },
        "releases": {
          "testedTag": "tested",
          "checks": [
            "build"
          ]
        },
        "samples": {
          "root": "Samples/"
        },
        "uiReview": {
          "paths": [
            "**/ui/**"
          ],
          "addedLines": [
            "@Composable"
          ],
          "ignore": [
            "formats/**"
          ]
        },
        "dependencyTickets": {
          "labels": [
            "not file related"
          ]
        },
        "untrustedReports": true
      },
      "tracker": {
        "type": "github",
        "repos": [
          "acme/viewer"
        ],
        "token": "GITHUB_TOKEN"
      },
