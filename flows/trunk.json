{
  "id": "trunk",
  "description": "Commits go straight to the main branch; the tester tests main; the board triages and talks to the owner.",
  "initial": "needs triage",
  "states": {
    "needs triage": {
      "description": "New; the board specifies it.",
      "meta": {
        "label": "needs triage",
        "status": "Todo",
        "holder": "board",
        "claimable": {
          "role": "board",
          "rank": 2
        }
      },
      "on": {
        "next": {
          "guard": {
            "type": "roleIs",
            "params": {
              "roles": [
                "board"
              ]
            }
          },
          "actions": [
            "claim"
          ]
        },
        "heartbeat": {
          "guard": "holdsClaim",
          "actions": [
            "touchClaim"
          ]
        },
        "release": {
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                {
                  "type": "roleIs",
                  "params": {
                    "roles": [
                      "board"
                    ]
                  }
                },
                "holdsClaim"
              ]
            }
          },
          "actions": [
            "comment",
            "releaseClaim"
          ]
        },
        "triage": {
          "target": "ready",
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                {
                  "type": "notClaimedBy",
                  "params": {
                    "roles": [
                      "developer",
                      "tester"
                    ]
                  }
                },
                {
                  "type": "hasAcceptance",
                  "params": {
                    "heading": "Acceptance"
                  }
                }
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "spec": {
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "updateBody",
            "comment"
          ]
        },
        "rework": {
          "target": "back to development",
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                "answered",
                {
                  "type": "notClaimedBy",
                  "params": {
                    "roles": [
                      "tester"
                    ]
                  }
                }
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "escalate": {
          "target": "human review",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            {
              "type": "sendCard",
              "params": {
                "field": "telegram"
              }
            }
          ]
        },
        "approve": {
          "guard": "answered",
          "target": "closed",
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "completed"
              }
            },
            "releaseClaim"
          ]
        },
        "drop": {
          "target": "closed",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "not_planned"
              }
            },
            "releaseClaim"
          ]
        },
        "postpone": {
          "target": "postponed",
          "guard": "answered",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "answer": {
          "actions": [
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "recordAnswer"
          ]
        }
      }
    },
    "ready": {
      "description": "Specified; a developer may take it.",
      "meta": {
        "label": "ready",
        "status": "Todo",
        "claimable": {
          "role": "developer",
          "rank": 2,
          "when": "dependenciesClosed"
        }
      },
      "on": {
        "next": {
          "target": "in development",
          "guard": {
            "type": "roleIs",
            "params": {
              "roles": [
                "developer"
              ]
            }
          },
          "actions": [
            "setStatus",
            "setLabel",
            "claim"
          ]
        },
        "spec": {
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "updateBody",
            "comment"
          ]
        },
        "escalate": {
          "target": "human review",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            {
              "type": "sendCard",
              "params": {
                "field": "telegram"
              }
            }
          ]
        },
        "drop": {
          "target": "closed",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "not_planned"
              }
            },
            "releaseClaim"
          ]
        },
        "answer": {
          "actions": [
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "recordAnswer"
          ]
        }
      }
    },
    "back to development": {
      "description": "Testing, the board or the owner found problems; the newest comment says what.",
      "meta": {
        "label": "back to development",
        "status": "Todo",
        "claimable": {
          "role": "developer",
          "rank": 1,
          "when": "dependenciesClosed"
        }
      },
      "on": {
        "next": {
          "target": "in development",
          "guard": {
            "type": "roleIs",
            "params": {
              "roles": [
                "developer"
              ]
            }
          },
          "actions": [
            "setStatus",
            "setLabel",
            "claim"
          ]
        },
        "spec": {
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "updateBody",
            "comment"
          ]
        },
        "escalate": {
          "target": "human review",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            {
              "type": "sendCard",
              "params": {
                "field": "telegram"
              }
            }
          ]
        },
        "drop": {
          "target": "closed",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "not_planned"
              }
            },
            "releaseClaim"
          ]
        },
        "answer": {
          "actions": [
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "recordAnswer"
          ]
        }
      }
    },
    "board review": {
      "description": "Waits for the board: a question, a blocker, or a passed ticket for the owner's eyes.",
      "meta": {
        "label": "board review",
        "status": "Todo",
        "holder": "board",
        "review": true,
        "claimable": {
          "role": "board",
          "rank": 1,
          "sort": "handover"
        }
      },
      "exit": [
        "clearOrigin"
      ],
      "on": {
        "next": {
          "guard": {
            "type": "roleIs",
            "params": {
              "roles": [
                "board"
              ]
            }
          },
          "actions": [
            "claim"
          ]
        },
        "heartbeat": {
          "guard": "holdsClaim",
          "actions": [
            "touchClaim"
          ]
        },
        "release": {
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                {
                  "type": "roleIs",
                  "params": {
                    "roles": [
                      "board"
                    ]
                  }
                },
                "holdsClaim"
              ]
            }
          },
          "actions": [
            "comment",
            "releaseClaim"
          ]
        },
        "triage": {
          "target": "ready",
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                {
                  "type": "notClaimedBy",
                  "params": {
                    "roles": [
                      "developer",
                      "tester"
                    ]
                  }
                },
                {
                  "type": "hasAcceptance",
                  "params": {
                    "heading": "Acceptance"
                  }
                }
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "spec": {
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "updateBody",
            "comment"
          ]
        },
        "sendback": [
          {
            "guard": {
              "type": "all",
              "params": {
                "guards": [
                  {
                    "type": "originIs",
                    "params": {
                      "from": "passed"
                    }
                  },
                  {
                    "type": "refuse",
                    "params": {
                      "status": 409,
                      "code": "wrong_state",
                      "message": "#{n} was passed by the tester; use escalate, approve or rework."
                    }
                  }
                ]
              }
            }
          },
          {
            "guard": {
              "type": "originIs",
              "params": {
                "from": "in development"
              }
            },
            "target": "back to development",
            "actions": [
              "setStatus",
              "comment",
              "setLabel",
              "releaseClaim"
            ]
          },
          {
            "guard": {
              "type": "originIs",
              "params": {
                "from": "testing"
              }
            },
            "target": "ready for testing",
            "actions": [
              "setStatus",
              "comment",
              "setLabel",
              "releaseClaim"
            ]
          },
          {
            "guard": {
              "type": "refuse",
              "params": {
                "status": 409,
                "code": "wrong_state",
                "message": "#{n} has no recorded hand-over from a developer or the tester; use rework or triage."
              }
            }
          }
        ],
        "rework": {
          "target": "back to development",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "escalate": {
          "target": "human review",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            {
              "type": "sendCard",
              "params": {
                "field": "telegram"
              }
            }
          ]
        },
        "approve": {
          "target": "closed",
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "completed"
              }
            },
            "releaseClaim"
          ]
        },
        "drop": {
          "target": "closed",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "not_planned"
              }
            },
            "releaseClaim"
          ]
        },
        "answer": {
          "actions": [
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "recordAnswer"
          ]
        }
      }
    },
    "human review": {
      "description": "The owner's inbox; only the board puts a ticket here.",
      "meta": {
        "label": "human review",
        "status": "Owner",
        "assignOwner": true,
        "inbox": true
      },
      "on": {
        "triage": {
          "target": "ready",
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                {
                  "type": "notClaimedBy",
                  "params": {
                    "roles": [
                      "developer",
                      "tester"
                    ]
                  }
                },
                {
                  "type": "hasAcceptance",
                  "params": {
                    "heading": "Acceptance"
                  }
                }
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            "dropInboxCard"
          ]
        },
        "rework": {
          "target": "back to development",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            "dropInboxCard"
          ]
        },
        "approve": {
          "target": "closed",
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "completed"
              }
            },
            "releaseClaim",
            "dropInboxCard"
          ]
        },
        "drop": {
          "target": "closed",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "not_planned"
              }
            },
            "releaseClaim",
            "dropInboxCard"
          ]
        },
        "postpone": {
          "target": "postponed",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            "dropInboxCard"
          ]
        },
        "answer": {
          "target": "needs triage",
          "actions": [
            "setStatus",
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "setLabel",
            "recordAnswer"
          ]
        }
      }
    },
    "postponed": {
      "description": "Parked on the owner's word.",
      "meta": {
        "label": "postponed",
        "status": "On hold",
        "parked": true
      },
      "on": {
        "drop": {
          "target": "closed",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "developer",
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            {
              "type": "setLabel",
              "params": {
                "reason": "not_planned"
              }
            },
            "releaseClaim"
          ]
        },
        "resume": {
          "target": "needs triage",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "answer": {
          "target": "needs triage",
          "actions": [
            "setStatus",
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "setLabel",
            "recordAnswer"
          ]
        }
      }
    },
    "in development": {
      "description": "A developer holds it.",
      "meta": {
        "label": "in development",
        "status": "In progress",
        "holder": "developer"
      },
      "on": {
        "heartbeat": {
          "guard": "holdsClaim",
          "actions": [
            "touchClaim"
          ]
        },
        "release": [
          {
            "guard": {
              "type": "all",
              "params": {
                "guards": [
                  {
                    "type": "roleIs",
                    "params": {
                      "roles": [
                        "developer"
                      ]
                    }
                  },
                  "holdsClaim",
                  "hasCommits"
                ]
              }
            },
            "target": "back to development",
            "actions": [
              "setStatus",
              "comment",
              "setLabel",
              "releaseClaim"
            ]
          },
          {
            "guard": {
              "type": "all",
              "params": {
                "guards": [
                  {
                    "type": "roleIs",
                    "params": {
                      "roles": [
                        "developer"
                      ]
                    }
                  },
                  "holdsClaim"
                ]
              }
            },
            "target": "ready",
            "actions": [
              "setStatus",
              "comment",
              "setLabel",
              "releaseClaim"
            ]
          }
        ],
        "handoff": {
          "target": "ready for testing",
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                "holdsClaim",
                "commitsOnMain"
              ]
            }
          },
          "actions": [
            "setStatus",
            {
              "type": "comment",
              "params": {
                "append": "\n\nCommits: {commits}"
              }
            },
            "setLabel",
            "releaseClaim",
            "recordHanded"
          ]
        },
        "stuck": {
          "target": "board review",
          "guard": "holdsClaim",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            "recordOrigin"
          ]
        },
        "expire": [
          {
            "guard": "hasCommits",
            "target": "back to development",
            "actions": [
              "setStatus",
              {
                "type": "comment",
                "params": {
                  "text": "The claim of {claim} expired after {lease} h without a heartbeat; the ticket is back in the queue."
                }
              },
              "setLabel",
              "releaseClaim"
            ]
          },
          {
            "target": "ready",
            "actions": [
              "setStatus",
              {
                "type": "comment",
                "params": {
                  "text": "The claim of {claim} expired after {lease} h without a heartbeat; the ticket is back in the queue."
                }
              },
              "setLabel",
              "releaseClaim"
            ]
          }
        ],
        "answer": {
          "actions": [
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "recordAnswer"
          ]
        }
      }
    },
    "testing": {
      "description": "The tester holds it.",
      "meta": {
        "label": "testing",
        "status": "In progress",
        "holder": "tester"
      },
      "on": {
        "heartbeat": {
          "guard": "holdsClaim",
          "actions": [
            "touchClaim"
          ]
        },
        "release": {
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                {
                  "type": "roleIs",
                  "params": {
                    "roles": [
                      "tester"
                    ]
                  }
                },
                "holdsClaim"
              ]
            }
          },
          "target": "ready for testing",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "pass": [
          {
            "guard": {
              "type": "all",
              "params": {
                "guards": [
                  "holdsClaim",
                  "gatesMatchBuild",
                  {
                    "type": "flag",
                    "params": {
                      "name": "owner_check"
                    }
                  },
                  "cardValid",
                  "buildOnMain",
                  "buildContainsCommits"
                ]
              }
            },
            "target": "board review",
            "actions": [
              "setStatus",
              {
                "type": "comment",
                "params": {
                  "append": "\n\nTested build: {build}, gates green at {gates}"
                }
              },
              "setLabel",
              "releaseClaim",
              {
                "type": "recordOrigin",
                "params": {
                  "from": "passed"
                }
              }
            ]
          },
          {
            "guard": {
              "type": "all",
              "params": {
                "guards": [
                  "holdsClaim",
                  "gatesMatchBuild",
                  "buildOnMain",
                  "buildContainsCommits"
                ]
              }
            },
            "target": "closed",
            "actions": [
              "setStatus",
              {
                "type": "comment",
                "params": {
                  "append": "\n\nTested build: {build}, gates green at {gates}"
                }
              },
              {
                "type": "setLabel",
                "params": {
                  "reason": "completed"
                }
              },
              "releaseClaim"
            ]
          }
        ],
        "fail": {
          "target": "back to development",
          "guard": {
            "type": "all",
            "params": {
              "guards": [
                "holdsClaim",
                "buildOnMain"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "stuck": {
          "target": "board review",
          "guard": "holdsClaim",
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim",
            "recordOrigin"
          ]
        },
        "expire": {
          "target": "ready for testing",
          "actions": [
            "setStatus",
            {
              "type": "comment",
              "params": {
                "text": "The claim of {claim} expired after {lease} h without a heartbeat; the ticket is back in the queue."
              }
            },
            "setLabel",
            "releaseClaim"
          ]
        },
        "answer": {
          "actions": [
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "recordAnswer"
          ]
        }
      }
    },
    "ready for testing": {
      "description": "Commits on main; waits for the tester.",
      "meta": {
        "label": "ready for testing",
        "status": "In progress",
        "claimable": {
          "role": "tester",
          "rank": 1,
          "when": "dependenciesClosed"
        }
      },
      "on": {
        "next": {
          "target": "testing",
          "guard": {
            "type": "roleIs",
            "params": {
              "roles": [
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "setLabel",
            "claim"
          ]
        },
        "rework": {
          "target": "back to development",
          "guard": {
            "type": "notClaimedBy",
            "params": {
              "roles": [
                "tester"
              ]
            }
          },
          "actions": [
            "setStatus",
            "comment",
            "setLabel",
            "releaseClaim"
          ]
        },
        "answer": {
          "actions": [
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "recordAnswer"
          ]
        }
      }
    },
    "closed": {
      "description": "Done (completed) or dropped (not planned).",
      "meta": {
        "status": "Done",
        "closed": true
      },
      "on": {
        "answer": {
          "target": "needs triage",
          "actions": [
            "setStatus",
            {
              "type": "comment",
              "params": {
                "field": "text"
              }
            },
            "setLabel",
            "recordAnswer"
          ]
        }
      }
    }
  }
}
