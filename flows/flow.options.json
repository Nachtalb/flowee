{
  "roles": {
    "board": {
      "sign": "Board",
      "who": "the board",
      "description": "Plans and specifies the tickets, sends work back, and is the only one who asks the owner.",
      "several": false
    },
    "developer": {
      "sign": "Developer",
      "who": "a developer",
      "description": "Builds what a ready ticket asks for and hands it to testing.",
      "several": true
    },
    "tester": {
      "sign": "Tester",
      "who": "the tester",
      "description": "Tests a handed-over ticket's build and passes or fails it.",
      "several": true
    },
    "owner": {
      "sign": "{owner}",
      "who": "the owner",
      "description": "Relays the owner's answers through the API (the chat does this too).",
      "several": false
    }
  },
  "commands": {
    "whoami": {
      "roles": [
        "board",
        "developer",
        "tester",
        "owner"
      ],
      "read": true
    },
    "queue": {
      "roles": [
        "board",
        "developer",
        "tester",
        "owner"
      ],
      "read": true
    },
    "show": {
      "roles": [
        "board",
        "developer",
        "tester",
        "owner"
      ],
      "read": true
    },
    "file": {
      "roles": [
        "board",
        "developer",
        "tester",
        "owner"
      ]
    },
    "next": {
      "roles": [
        "board",
        "developer",
        "tester"
      ]
    },
    "heartbeat": {
      "roles": [
        "board",
        "developer",
        "tester"
      ],
      "state": false
    },
    "release": {
      "roles": [
        "board",
        "developer",
        "tester"
      ],
      "input": {
        "comment": {
          "required": [
            "developer",
            "tester"
          ]
        }
      }
    },
    "handoff": {
      "roles": [
        "developer"
      ],
      "input": {
        "comment": "required"
      }
    },
    "pass": {
      "roles": [
        "tester"
      ],
      "input": {
        "comment": "required",
        "build": "sha",
        "gates": "gates",
        "owner_check": "flag"
      }
    },
    "fail": {
      "roles": [
        "tester"
      ],
      "input": {
        "comment": "required",
        "build": "sha"
      }
    },
    "stuck": {
      "roles": [
        "developer",
        "tester"
      ],
      "input": {
        "comment": "required"
      }
    },
    "triage": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "required"
      }
    },
    "spec": {
      "roles": [
        "board"
      ],
      "input": {
        "body": "body",
        "title": "title",
        "comment": "optional"
      }
    },
    "sendback": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "required"
      }
    },
    "rework": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "required"
      }
    },
    "escalate": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "card"
      }
    },
    "approve": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "optional"
      }
    },
    "drop": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "required"
      }
    },
    "postpone": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "optional"
      }
    },
    "resume": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "optional"
      }
    },
    "answer": {
      "roles": [
        "owner"
      ],
      "input": {
        "text": "text"
      }
    },
    "checked": {
      "roles": [
        "board"
      ],
      "input": {
        "comment": "required"
      },
      "features": "userFeedback.autoTriage"
    },
    "pr": {
      "roles": [
        "developer"
      ],
      "state": false
    },
    "merge": {
      "roles": [
        "developer"
      ]
    }
  },
  "leaseHours": 3,
  "reaper": {
    "event": "expire",
    "role": "board"
  },
  "inboxRoles": [
    "board",
    "owner"
  ],
  "commitSuffix": " (#{n})",
  "ownerRole": "owner",
  "ticks": [
    {
      "event": "released",
      "role": "board",
      "features": "releases.hold"
    },
    {
      "event": "feedback",
      "role": "board",
      "features": "userFeedback.autoTriage=false"
    }
  ]
}
